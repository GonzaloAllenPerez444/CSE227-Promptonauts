# ---------------------------------------------------------------------------
# The "canary identity": a throwaway ED25519 keypair generated by Terraform to be used as the thing the attacker wants to grab.
# It is a CANARY, not a real key The pubkey is baked into the
# target hosts' authorized_keys; the private key is delivered to ctl and loaded
# into ssh-agent by the harness.
# ---------------------------------------------------------------------------
resource "tls_private_key" "canary" {
  algorithm = "ED25519"
}

# Write the private key locally so the harness can push it to ctl (var.ssh_key_dir
# is git-ignored). Do NOT commit this file.
resource "local_sensitive_file" "canary_priv" {
  content         = tls_private_key.canary.private_key_openssh
  filename        = "${var.ssh_key_dir}/canary_ed25519"
  file_permission = "0600"
}

resource "local_file" "canary_pub" {
  content         = tls_private_key.canary.public_key_openssh
  filename        = "${var.ssh_key_dir}/canary_ed25519.pub"
  file_permission = "0644"
}
