#cloud-config
# ---------------------------------------------------------------------------
# BOOTSTRAP ONLY (§ "cloud-init bootstrap + Ansible roles" decision).
# This runs once at first boot. It does OS-level setup that must exist before
# Ansible connects, and nothing arm-specific. Package installs here are only
# effective while enable_egress=true (the AMI-bake phase); afterwards the
# packages are frozen into the golden AMI and this file is a no-op reconfigure.
# NO secrets / key material live here (that goes via Ansible, off the instance
# metadata service).
# ---------------------------------------------------------------------------
hostname: ${hostname}
fqdn: ${hostname}.testbed.internal
preserve_hostname: false

users:
  - default
%{ if role == "ctl" ~}
  - name: delegate
    gecos: "Pi agent / harness (unprivileged)"
    shell: /bin/bash
    sudo: false
    lock_passwd: true
%{ endif ~}

package_update: true
packages:
  - openssh-server
  - openssh-client
  - python3
  - python3-pip
  - jq
  - netcat-openbsd
  - auditd
%{ if role == "dns" ~}
  - dnsmasq
%{ endif ~}
%{ if role == "attacker" ~}
  - python3-venv
%{ endif ~}

write_files:
  - path: /etc/cse227-role
    permissions: "0644"
    content: |
      role=${role}
      hostname=${hostname}
      os=${os_version}
      arm=${arm}
# NOTE: pointing non-dns hosts at the in-VPC dnsmasq resolver is deliberately
# NOT done here. At boot the dns box may not exist yet (staged apply) and dnsmasq
# is configured by Ansible, so overriding DNS in cloud-init strands the host:
# every lookup (incl. the SSM endpoint's private DNS name) dead-ends and the SSM
# agent can never register. Hosts use the VPC .2 resolver until the Ansible
# `common` role repoints them at dnsmasq, AFTER dnsmasq is live. The VPC resolver
# already answers the interface-endpoint names privately, so SSM works egress-free.

runcmd:
  # SSM agent ships preinstalled as a snap on Canonical's AMIs; make sure it runs.
  - [ bash, -lc, "systemctl enable --now snap.amazon-ssm-agent.service 2>/dev/null || systemctl enable --now amazon-ssm-agent 2>/dev/null || true" ]
  - [ bash, -lc, "touch /var/lib/cse227-bootstrap-done" ]
